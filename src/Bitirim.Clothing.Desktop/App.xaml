<Application x:Class="Bitirim.Clothing.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Charcoal base with a restrained lime accent. The WebView carries the
             real design language; these values only cover native chrome that
             appears before the UI has loaded. -->
        <Color x:Key="BackgroundColor">#0E0F0D</Color>
        <Color x:Key="SurfaceColor">#161814</Color>
        <Color x:Key="AccentColor">#A8E10C</Color>
        <Color x:Key="TextColor">#E7EAE3</Color>
        <Color x:Key="MutedColor">#7C8378</Color>

        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    </Application.Resources>
</Application>
