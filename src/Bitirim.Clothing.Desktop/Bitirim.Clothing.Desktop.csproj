<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>BitirimClothingCreator</AssemblyName>
    <RootNamespace>Bitirim.Clothing.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The one place the version is written. build.ps1 reads it from here,
         and the UI badge reads the assembly, so the two cannot drift. -->
    <Version>0.5.2</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Product>Bitirim Clothing Creator</Product>
    <Company>Bitirim</Company>
    <Description>GTA V / FiveM Clothing Development Studio</Description>
    <Copyright>Copyright (c) Bitirim</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!--
    WPF's implicit usings bring in System.Windows.Shapes, whose Path type would
    otherwise collide with System.IO.Path. Import System.IO explicitly and alias
    Path to the file-system one, which is the only Path this project uses.
  -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.IO.Path" Alias="Path" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bitirim.Clothing.Core\Bitirim.Clothing.Core.csproj" />
    <ProjectReference Include="..\Bitirim.Clothing.Editor\Bitirim.Clothing.Editor.csproj" />
    <ProjectReference Include="..\Bitirim.Clothing.Export\Bitirim.Clothing.Export.csproj" />
    <ProjectReference Include="..\Bitirim.Clothing.FiveFury\Bitirim.Clothing.FiveFury.csproj" />
    <ProjectReference Include="..\Bitirim.Clothing.Textures\Bitirim.Clothing.Textures.csproj" />
    <ProjectReference Include="..\Bitirim.Clothing.Validation\Bitirim.Clothing.Validation.csproj" />
  </ItemGroup>
</Project>
